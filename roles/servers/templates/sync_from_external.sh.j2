#!/bin/bash
# Sync external drive to cold storage
# Generated by Ansible - do not edit manually

set -euo pipefail

DRY_RUN=""
if [[ "${1:-}" == "--dry-run" || "${1:-}" == "-n" ]]; then
    DRY_RUN="--dry-run"
fi

MOUNT_POINT="{{ external_drive_mount }}"
DEST_DIR="/cold_storage/archive_backup"
LOG_PREFIX="[$(date '+%Y-%m-%d %H:%M:%S')]"

echo "$LOG_PREFIX Starting sync from external drive to cold storage${DRY_RUN:+ (dry run)}"

# Mount the external drive
if ! mountpoint -q "$MOUNT_POINT"; then
    echo "$LOG_PREFIX Mounting external drive at $MOUNT_POINT"
    if ! sudo mount "$MOUNT_POINT"; then
        echo "$LOG_PREFIX ERROR: Failed to mount external drive at $MOUNT_POINT"
        echo "$LOG_PREFIX Is the drive plugged in?"
        exit 1
    fi
fi

# Ensure destination exists
mkdir -p "$DEST_DIR"
if [ ! -d "$DEST_DIR" ]; then
    echo "$LOG_PREFIX ERROR: Destination directory $DEST_DIR does not exist"
    sudo umount "$MOUNT_POINT" 2>/dev/null || true
    exit 1
fi

echo "$LOG_PREFIX Syncing: $MOUNT_POINT/ -> $DEST_DIR/"

if rsync -rltz --delete --progress --modify-window=2 --exclude='.*DS_Store' $DRY_RUN "$MOUNT_POINT/archive_primary_copy/" "$DEST_DIR/"; then
    echo "$LOG_PREFIX Successfully synced to cold storage"
else
    echo "$LOG_PREFIX ERROR: Sync failed"
    sudo umount "$MOUNT_POINT" 2>/dev/null || true
    exit 1
fi

# Unmount after sync
echo "$LOG_PREFIX Unmounting external drive"
sudo umount "$MOUNT_POINT"

echo "$LOG_PREFIX External drive sync completed"
