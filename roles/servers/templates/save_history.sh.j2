#!/bin/bash
# Save bash history to ZFS server
# Generated by Ansible - do not edit manually

set -euo pipefail
LOG_PREFIX="[$(date '+%Y-%m-%d %H:%M:%S')]"

HISTORY_FILE="/home/{{ local_user }}/.bash_history"
{% if server_role | default('') == 'zfs' %}
DEST_DIR="/burkpool/history_files/{{ inventory_hostname }}"
echo "$LOG_PREFIX Saving history to $DEST_DIR"
mkdir -p "$DEST_DIR"
cp "$HISTORY_FILE" "$DEST_DIR/.bash_history"
echo "$LOG_PREFIX Done"
{% else %}
{% if server_role | default('') == 'infra' %}
DEST_HOST="{{ backup_target_host }}"
{% elif server_role | default('') == 'backup' %}
DEST_HOST="{{ backup_source_host }}"
{% endif %}
DEST_USER="{{ local_user }}"
DEST_DIR="/burkpool/history_files/{{ inventory_hostname }}"
SSH_KEY="/home/{{ local_user }}/.ssh/id_ed25519_servers"
SSH_OPTS="-i ${SSH_KEY} -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10"

echo "$LOG_PREFIX Saving history to $DEST_HOST:$DEST_DIR"
if ! ping -c 1 -W 5 "$DEST_HOST" > /dev/null 2>&1; then
    echo "$LOG_PREFIX ERROR: Cannot reach $DEST_HOST"
    exit 1
fi

ssh ${SSH_OPTS} "${DEST_USER}@${DEST_HOST}" "mkdir -p '$DEST_DIR'"

if scp ${SSH_OPTS} "$HISTORY_FILE" "${DEST_USER}@${DEST_HOST}:${DEST_DIR}/.bash_history"; then
    echo "$LOG_PREFIX Done"
else
    echo "$LOG_PREFIX ERROR: scp failed"
    exit 1
fi
{% endif %}
