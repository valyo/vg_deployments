#!/bin/bash
# Show disk model, capacity and temperature for all drives
# Generated by Ansible - do not edit manually

smartctl --scan | awk '{print $1}' | while read dev; do
  info=$(sudo smartctl -i "$dev")
  brand=$(echo "$info" | grep "Device Model\|Model Number" | head -1 | sed 's/.*: *//')
  capacity=$(echo "$info" | grep "Total NVM Capacity\|User Capacity" | head -1 | sed 's/.*\[//;s/\]//')
  temp=$(sudo smartctl -A "$dev" | grep -i temperature | head -1 | awk '{print $10}')
  printf "%-12s %-30s %-12s %s°C\n" "$dev" "$brand" "$capacity" "$temp"
done
