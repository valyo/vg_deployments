#!/bin/bash
# Save bash history to ZFS server
# Generated by Ansible - do not edit manually

HISTORY_FILE="/home/{{ local_user }}/.bash_history"
{% if server_role | default('') == 'zfs' %}
DEST_DIR="/burkpool/history_files/{{ inventory_hostname }}"
mkdir -p "$DEST_DIR"
cp "$HISTORY_FILE" "$DEST_DIR/.bash_history"
{% else %}
{% if server_role | default('') == 'infra' %}
DEST_HOST="{{ backup_target_host }}"
{% elif server_role | default('') == 'backup' %}
DEST_HOST="{{ backup_source_host }}"
{% endif %}
DEST_USER="{{ local_user }}"
DEST_DIR="/burkpool/history_files/{{ inventory_hostname }}"

if ! ping -c 1 -W 5 "$DEST_HOST" > /dev/null 2>&1; then
    exit 1
fi

ssh -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 \
    "${DEST_USER}@${DEST_HOST}" "mkdir -p '$DEST_DIR'"

scp -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 \
    "$HISTORY_FILE" "${DEST_USER}@${DEST_HOST}:${DEST_DIR}/.bash_history"
{% endif %}
