#!/bin/bash
# Backup script - pulls data from primary ZFS server
# Generated by Ansible - do not edit manually

set -euo pipefail

DRY_RUN=""
if [[ "${1:-}" == "--dry-run" || "${1:-}" == "-n" ]]; then
    DRY_RUN="--dry-run"
fi

# Configuration
SOURCE_HOST="{{ backup_source_host }}"
SOURCE_USER="{{ local_user }}"
SOURCE_DIR="{{ backup_source_dir }}"
LOCAL_DIR="{{ backup_local_dir }}"
LOG_PREFIX="[$(date '+%Y-%m-%d %H:%M:%S')]"
SSH_KEY="/home/{{ local_user }}/.ssh/id_ed25519_servers"
SSH_OPTS="-i ${SSH_KEY} -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10"

# Rsync options
RSYNC_OPTS="{{ backup_rsync_opts | default('-avz --delete --progress') }}"

echo "$LOG_PREFIX Starting backup pull from $SOURCE_HOST:$SOURCE_DIR to $LOCAL_DIR${DRY_RUN:+ (dry run)}"

# Check if source host is reachable
if ! ping -c 1 -W 5 "$SOURCE_HOST" > /dev/null 2>&1; then
    echo "$LOG_PREFIX ERROR: Cannot reach $SOURCE_HOST"
    exit 1
fi

# Ensure local backup directory exists
mkdir -p "$LOCAL_DIR"

echo "$LOG_PREFIX Syncing: $SOURCE_HOST:$SOURCE_DIR/ -> $LOCAL_DIR/"

if rsync $RSYNC_OPTS --numeric-ids $DRY_RUN \
    --rsync-path="sudo rsync" \
    -e "ssh ${SSH_OPTS}" \
    "${SOURCE_USER}@${SOURCE_HOST}:${SOURCE_DIR}/" \
    "${LOCAL_DIR}/"; then
    echo "$LOG_PREFIX Successfully synced $SOURCE_HOST:$SOURCE_DIR to $LOCAL_DIR"
else
    echo "$LOG_PREFIX ERROR: Failed to sync from $SOURCE_HOST:$SOURCE_DIR"
    exit 1
fi

echo "$LOG_PREFIX Backup pull completed"
