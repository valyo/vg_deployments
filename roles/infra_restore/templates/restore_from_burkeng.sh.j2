#!/bin/bash
# Restore from burkeng - pulls infra backup data from primary ZFS storage
# Generated by Ansible - do not edit manually
#
# Inverse of backup_to_burkeng.sh:
#   backup:  rsync /storage/apps/homeassistant  host:TARGET_DIR/
#            → TARGET_DIR/homeassistant/
#   restore: rsync host:TARGET_DIR/homeassistant/  /storage/apps/homeassistant/
#            → /storage/apps/homeassistant/...

set -euo pipefail

SOURCE_HOST="{{ backup_target_host }}"
SOURCE_USER="{{ local_user }}"
SOURCE_DIR="{{ backup_target_dir | default('/burkpool/backups/infra') }}"
LOG_PREFIX="[$(date '+%Y-%m-%d %H:%M:%S')]"
SSH_KEY="/home/{{ local_user }}/.ssh/id_ed25519_servers"
SSH_OPTS="-i ${SSH_KEY} -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10"

DRY_RUN=""
if [[ "${1:-}" == "--dry-run" || "${1:-}" == "-n" ]]; then
    DRY_RUN="--dry-run"
fi

DELETE_FLAG=""
{% if restore_rsync_delete | default(false) %}
DELETE_FLAG="--delete"
{% endif %}

RSYNC_OPTS="{{ restore_rsync_opts | default('-avz --numeric-ids --progress') }} ${DELETE_FLAG}"

{% set _restore_paths = restore_paths if (restore_paths | default([]) | length > 0) else (backup_paths | default([])) %}
RESTORE_PATHS=(
{% for path in _restore_paths %}
    "{{ path }}"
{% endfor %}
)

echo "$LOG_PREFIX Starting restore from ${SOURCE_USER}@${SOURCE_HOST}:${SOURCE_DIR}"

if ! ping -c 1 -W 5 "$SOURCE_HOST" > /dev/null 2>&1; then
    echo "$LOG_PREFIX WARNING: Cannot ping $SOURCE_HOST; continuing with SSH/rsync anyway"
fi

for dest_path in "${RESTORE_PATHS[@]}"; do
    if [ -z "$dest_path" ]; then
        continue
    fi

    # Strip trailing slash so basename/dirname are stable
    dest_path="${dest_path%/}"
    remote_name="$(basename "$dest_path")"
    remote_path="${SOURCE_DIR}/${remote_name}/"

    echo "$LOG_PREFIX Restoring: ${SOURCE_HOST}:${remote_path} -> ${dest_path}/"

    # Destination must be the app dir itself. Trailing slash on both sides
    # copies remote *contents* into dest_path (not into the parent).
    mkdir -p "$dest_path"

    if sudo rsync $RSYNC_OPTS $DRY_RUN \
        --rsync-path="sudo rsync" \
        -e "ssh ${SSH_OPTS}" \
        "${SOURCE_USER}@${SOURCE_HOST}:${remote_path}" \
        "${dest_path}/"; then
        echo "$LOG_PREFIX Successfully restored: $dest_path"
    else
        echo "$LOG_PREFIX ERROR: Failed to restore: $dest_path"
        exit 1
    fi
done

echo "$LOG_PREFIX Restore completed"
