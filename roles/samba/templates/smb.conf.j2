[global]
        netbios name = {{ samba_name }}
        server string = samba
        host msdfs = no
        idmap config * : range = 3000-7999
        security = user
        server min protocol = SMB2
        map to guest = Bad User

        # disable printing services
        load printers = no
        printing = bsd
        printcap name = /dev/null
        disable spoolss = yes

[{{ samba_share_name }}]
        path = /storage
        comment = Shared
        browseable = yes
        read only = yes
        guest ok = yes
        write list = @smb
        force user = {{ samba_user }}
        force group = smb

